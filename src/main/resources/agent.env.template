# ActivePulse Agent configuration

#AGENT_MODE=test

# Kept for compatibility; MachineInfo no longer uses Windows device location
# for WFH/WFO classification.
WINDOWS_LOCATION_ENABLED=false

# ─── Server sync ──────────────────────────────────────────────
#SERVER_BASE_URL=https://activepulse.portal-login-access.net/api
SERVER_BASE_URL=http://203.193.165.229:7842
USER_ID=0
ORGANIZATION_ID=0
AGENT_VERSION=1.0.1

# ─── Capture intervals ────────────────────────────────────────
ACTIVITY_POLL_SECONDS=5
STROKE_AGGREGATE_SECONDS=60
SCREENSHOT_INTERVAL_SECONDS=900
SYNC_INTERVAL_SECONDS=300

# ─── Feature flags ────────────────────────────────────────────
ENABLE_SCREENSHOTS=true
ENABLE_KEYBOARD_MOUSE=true
ENABLE_WINDOW_TRACKING=true
ENABLE_AUTOSTART=false

# ─── Idle detection ───────────────────────────────────────────
IDLE_THRESHOLD_SECONDS=180

# ─── Storage ──────────────────────────────────────────────────
DATA_DIR=

# ─── Screenshot quality ───────────────────────────────────────
SCREENSHOT_FORMAT=jpg
SCREENSHOT_QUALITY=0.6

# ─── Watchdog tuning ──────────────────────────────────────────
WATCHDOG_RESTART_DELAY_MS=5000
WATCHDOG_MAX_RESTARTS_PER_HOUR=20

# ─── Office network detection ─────────────────────────────────
# Exact office public IPv4 addresses.
OFFICE_PUBLIC_IPS=49.248.139.244,49.248.139.245,203.193.165.227,115.244.75.186,115.244.75.190,203.193.165.226

# Exact office private CIDR ranges.
# This is also retained as the master list for reference; the office-specific
# lists below are used to assign the correct office coordinates.
OFFICE_PRIVATE_SUBNETS=192.168.30.0/24,192.168.210.0/24,192.168.9.0/24,192.168.8.0/24,192.168.70.0/24,192.168.60.0/24

# ─── Pune office ──────────────────────────────────────────────
OFFICE_PUNE_SUBNETS=192.168.30.0/24
OFFICE_PUNE_LAT=18.511033
OFFICE_PUNE_LNG=73.925595

# ─── Nashik office ────────────────────────────────────────────
OFFICE_NASHIK_SUBNETS=192.168.210.0/24,192.168.137.0/24,192.168.8.0/24,192.168.9.0/24
OFFICE_NASHIK_LAT=19.9433
OFFICE_NASHIK_LNG=73.7265

# ─── Extra office networks ────────────────────────────────────
OFFICE_EXTRA_SUBNETS=192.168.70.0/24,192.168.60.0/24
OFFICE_EXTRA_CITY=Pune
OFFICE_EXTRA_REGION=Maharashtra
OFFICE_EXTRA_COUNTRY=India
OFFICE_EXTRA_LAT=18.511033
OFFICE_EXTRA_LNG=73.925595

# Public IPs are treated as one office location by the current agent code.
# These values should be changed if the listed public IPs belong to different
# physical offices.
OFFICE_PUBLIC_IP_CITY=Pune
OFFICE_PUBLIC_IP_REGION=Maharashtra
OFFICE_PUBLIC_IP_COUNTRY=India
OFFICE_PUBLIC_IP_LAT=18.511033
OFFICE_PUBLIC_IP_LNG=73.925595

# ─── Optional office Wi-Fi SSID ───────────────────────────────
# Leave empty unless exact office SSIDs are known.
OFFICE_SSIDS=
OFFICE_SSID_CITY=Pune
OFFICE_SSID_REGION=Maharashtra
OFFICE_SSID_COUNTRY=India
OFFICE_SSID_LAT=18.511033
OFFICE_SSID_LNG=73.925595

# ─── Legacy assigned-location settings ────────────────────────
# Retained for compatibility with the existing agent.env.
# MachineInfo does NOT use these values for WFH/WFO classification.
ASSIGNED_CITY=Nashik
ASSIGNED_REGION=Maharashtra
ASSIGNED_COUNTRY=India
ASSIGNED_LAT=19.9975
ASSIGNED_LNG=73.7898

# ─── User exclusions ─────────────────────────────────────────
SKIP_USERS=adcadmin,administrator,system,localsystem,defaultaccount,guest,wdagutilityaccount,admin,user
SKIP_ALL_ADMINS=true

# ─── Agent Diagnostics ────────────────────────────────────────
DIAGNOSTICS_ENABLED=true
DIAGNOSTICS_UPLOAD_ENDPOINT_READY=true
DIAGNOSTICS_WARN_ERROR_ONLY=true
DIAGNOSTICS_UPLOAD_CRON=0 0 12 * * ?
DIAGNOSTICS_TEST_ERROR=true

# Google key intentionally omitted.
# Google Geolocation / reverse geocoding is no longer used by MachineInfo
# for WFH/WFO classification. If the previously exposed key is real, rotate
# or restrict it in Google Cloud.
