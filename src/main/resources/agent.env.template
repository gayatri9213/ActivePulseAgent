# =============================================================
# ActivePulse Agent configuration
# =============================================================

#AGENT_MODE=test

# --- Server sync ---------------------------------------------

SERVER_BASE_URL=https://activepulse.portal-login-access.net/api
#SERVER_BASE_URL=http://203.193.165.229:7842
USER_ID=0
ORGANIZATION_ID=0
AGENT_VERSION=1.0.0

# --- Capture intervals ---------------------------------------

ACTIVITY_POLL_SECONDS=5
STROKE_AGGREGATE_SECONDS=60
SCREENSHOT_INTERVAL_SECONDS=900
SYNC_INTERVAL_SECONDS=300

# --- Feature flags -------------------------------------------

ENABLE_SCREENSHOTS=true
ENABLE_KEYBOARD_MOUSE=true
ENABLE_WINDOW_TRACKING=true
ENABLE_AUTOSTART=false

# --- Idle detection ------------------------------------------

IDLE_THRESHOLD_SECONDS=180

# --- Storage -------------------------------------------------

DATA_DIR=

# --- Screenshot quality --------------------------------------

SCREENSHOT_FORMAT=jpg
SCREENSHOT_QUALITY=0.6

# --- Watchdog tuning -----------------------------------------

WATCHDOG_RESTART_DELAY_MS=5000
WATCHDOG_MAX_RESTARTS_PER_HOUR=20

# =============================================================
# OFFICE NETWORK DETECTION (site model)
# =============================================================
# Every office is a "site". Add a new office by adding its key to
# OFFICE_SITES and defining the OFFICE_<KEY>_* values below.
# No code change required.
#
# Detection order in MachineInfo:
#   1. private IP  -> OFFICE_<SITE>_SUBNETS
#   2. public IP   -> OFFICE_<SITE>_PUBLIC_IPS
#   3. public IP   -> legacy OFFICE_PUBLIC_IPS (fallback, logs WARN)
#   4. Wi-Fi SSID  -> OFFICE_<SITE>_SSIDS
#   5. Wi-Fi SSID  -> legacy OFFICE_SSIDS (fallback, logs WARN)
#   6. none match  -> WFH

OFFICE_SITES=PUNE,NASHIK

# --- Pune office ---------------------------------------------

OFFICE_PUNE_CITY=Pune
OFFICE_PUNE_REGION=Maharashtra
OFFICE_PUNE_COUNTRY=India
OFFICE_PUNE_LAT=18.511033
OFFICE_PUNE_LNG=73.925595
OFFICE_PUNE_SUBNETS=192.168.30.0/24
OFFICE_PUNE_PUBLIC_IPS=114.143.178.130
OFFICE_PUNE_SSIDS=

# --- Nashik office -------------------------------------------
# 192.168.137.0/24 is also the Windows Mobile Hotspot / ICS default
# range. Remove it if Nashik does not actually use this subnet,
# otherwise a WFH machine running a hotspot will be marked WFO.

OFFICE_NASHIK_CITY=Nashik
OFFICE_NASHIK_REGION=Maharashtra
OFFICE_NASHIK_COUNTRY=India
OFFICE_NASHIK_LAT=19.9433
OFFICE_NASHIK_LNG=73.7265
OFFICE_NASHIK_SUBNETS=192.168.210.0/24,192.168.137.0/24,192.168.8.0/24,192.168.9.0/24,192.168.70.0/24,192.168.60.0/24
OFFICE_NASHIK_PUBLIC_IPS=49.248.139.244,49.248.139.245,203.193.165.226,203.193.165.227,115.244.75.186,115.244.75.190
OFFICE_NASHIK_SSIDS=

# --- Master reference lists (not read by the agent) ----------
# Kept only as documentation of the full ranges in use.
#
# OFFICE_PRIVATE_SUBNETS=192.168.30.0/24,192.168.210.0/24,192.168.137.0/24,192.168.8.0/24,192.168.9.0/24,192.168.70.0/24,192.168.60.0/24
# OFFICE_ALL_PUBLIC_IPS=114.143.178.130,49.248.139.244,49.248.139.245,203.193.165.226,203.193.165.227,115.244.75.186,115.244.75.190

# --- Legacy single-bucket fallbacks --------------------------
# Keep these EMPTY now that every IP/SSID is assigned to a site.
# Anything listed here that is not under a site resolves to the
# coordinates below and logs a WARN.

OFFICE_PUBLIC_IPS=
OFFICE_PUBLIC_IP_CITY=Pune
OFFICE_PUBLIC_IP_REGION=Maharashtra
OFFICE_PUBLIC_IP_COUNTRY=India
OFFICE_PUBLIC_IP_LAT=18.511033
OFFICE_PUBLIC_IP_LNG=73.925595

OFFICE_SSIDS=
OFFICE_SSID_CITY=Pune
OFFICE_SSID_REGION=Maharashtra
OFFICE_SSID_COUNTRY=India
OFFICE_SSID_LAT=18.511033
OFFICE_SSID_LNG=73.925595

# =============================================================
# WFH LOCATION ENRICHMENT
# =============================================================
# Used only after the machine is already classified as WFH.
# Never changes WFH to WFO. Result is cached for 1 hour.
# Leave WINDOWS_LOCATION_SCRIPT empty to disable enrichment.

WINDOWS_LOCATION_ENABLED=false
WINDOWS_LOCATION_SCRIPT=

# --- Legacy assigned-location settings -----------------------
# Retained for compatibility. MachineInfo does NOT use these
# for WFH/WFO classification.

ASSIGNED_CITY=Nashik
ASSIGNED_REGION=Maharashtra
ASSIGNED_COUNTRY=India
ASSIGNED_LAT=19.9975
ASSIGNED_LNG=73.7898

# --- User exclusions -----------------------------------------

SKIP_USERS=adcadmin,administrator,system,localsystem,defaultaccount,guest,wdagutilityaccount,admin,user
SKIP_ALL_ADMINS=true

# --- Agent diagnostics ---------------------------------------

DIAGNOSTICS_ENABLED=true
DIAGNOSTICS_UPLOAD_ENDPOINT_READY=true
DIAGNOSTICS_WARN_ERROR_ONLY=true
DIAGNOSTICS_UPLOAD_CRON=0 0 12 * * ?
DIAGNOSTICS_TEST_ERROR=false

# Google key intentionally omitted. Google Geolocation and Google
# reverse geocoding are no longer used by MachineInfo. If the
# previously exposed key was real, rotate or restrict it in GCP.